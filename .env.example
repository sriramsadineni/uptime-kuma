# Copy to .env and fill in values. Used when using external MariaDB/MySQL.
# Uptime Kuma app database (optional – omit to use SQLite or setup UI)

UPTIME_KUMA_DB_TYPE=mariadb
UPTIME_KUMA_DB_HOSTNAME=127.0.0.1
UPTIME_KUMA_DB_PORT=3306
UPTIME_KUMA_DB_NAME=kumadb
UPTIME_KUMA_DB_USERNAME=kuma
UPTIME_KUMA_DB_PASSWORD=your_password

# Optional: Unix socket (if set, hostname/port ignored)
# UPTIME_KUMA_DB_SOCKET=

# Optional: SSL for managed/cloud DBs
# UPTIME_KUMA_DB_SSL=false
# UPTIME_KUMA_DB_CA=

# Optional: Connection pool size (default 10)
# UPTIME_KUMA_DB_POOL_MAX_CONNECTIONS=10
